{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/pr-review-result.schema.json",
  "title": "PR Review Result",
  "description": "Machine-readable result of a pull request review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review",
    "decision",
    "summary",
    "findings",
    "risks",
    "validation",
    "limitations",
    "open_questions",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pr_number",
        "title",
        "author",
        "base_ref",
        "base_sha",
        "head_ref",
        "head_sha",
        "reviewed_at",
        "reviewer",
        "report_status",
        "review_mode",
        "reviewed_scope",
        "excluded_scope"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pr_number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "base_ref": { "type": "string", "minLength": 1 },
        "base_sha": { "$ref": "#/$defs/gitSha" },
        "head_ref": { "type": "string", "minLength": 1 },
        "head_sha": { "$ref": "#/$defs/gitSha" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string", "minLength": 1 },
        "report_status": { "enum": ["CURRENT", "STALE"] },
        "review_mode": { "enum": ["READ_ONLY", "PUBLISHED"] },
        "reviewed_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excluded_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mergeable", "rationale", "blocking_finding_ids"],
      "properties": {
        "status": {
          "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT", "INCOMPLETE"]
        },
        "mergeable": {
          "type": ["boolean", "null"],
          "description": "Use null when the result is unknown or incomplete."
        },
        "rationale": { "type": "string", "minLength": 1 },
        "blocking_finding_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingId" },
          "uniqueItems": true
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "change_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "change", "external_behavior", "risk", "validation"],
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 1 },
          "external_behavior": { "type": "string", "minLength": 1 },
          "risk": { "$ref": "#/$defs/riskLevel" },
          "validation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "action", "status"],
        "properties": {
          "finding_id": { "$ref": "#/$defs/findingId" },
          "action": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "completed", "waived"] }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "level", "description", "mitigation"],
        "properties": {
          "category": { "$ref": "#/$defs/riskCategory" },
          "level": { "$ref": "#/$defs/riskLevel" },
          "description": { "type": "string", "minLength": 1 },
          "mitigation": { "type": "string", "minLength": 1 },
          "owner": { "type": ["string", "null"] }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_status", "reviewer_runs", "ci_checks", "not_run"],
      "properties": {
        "overall_status": {
          "enum": ["PASSED", "FAILED", "PARTIAL", "NOT_RUN", "UNKNOWN"]
        },
        "reviewer_runs": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationRun" }
        },
        "ci_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/ciCheck" }
        },
        "not_run": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "reason"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "non_blocking_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "recommendation", "value"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NOTE-[0-9]{3,}$"
          },
          "category": { "$ref": "#/$defs/findingCategory" },
          "recommendation": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^PRR-[0-9]{3,}$"
    },
    "riskLevel": {
      "enum": ["High", "Medium", "Low", "None", "Unknown"]
    },
    "riskCategory": {
      "enum": [
        "security-privacy",
        "data-integrity",
        "reliability-concurrency",
        "performance-scalability",
        "api-compatibility",
        "deployment-rollback",
        "maintainability",
        "other"
      ]
    },
    "findingCategory": {
      "enum": [
        "requirements",
        "correctness",
        "security",
        "privacy",
        "data-integrity",
        "concurrency",
        "reliability",
        "performance",
        "compatibility",
        "api-contract",
        "testing",
        "maintainability",
        "observability",
        "deployment",
        "documentation",
        "dependency",
        "other"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit_sha"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "symbol": { "type": ["string", "null"] },
        "side": { "enum": ["LEFT", "RIGHT", "FILE", null] },
        "commit_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "enum": ["code", "test", "ci", "log", "spec", "reproduction", "analysis", "other"]
        },
        "description": { "type": "string", "minLength": 1 },
        "reference": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "blocking",
        "confidence",
        "category",
        "title",
        "location",
        "observation",
        "trigger",
        "impact",
        "evidence",
        "remediation",
        "verification",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "severity": { "enum": ["S0", "S1", "S2", "S3", "S4"] },
        "blocking": { "type": "boolean" },
        "confidence": { "enum": ["High", "Medium"] },
        "category": { "$ref": "#/$defs/findingCategory" },
        "title": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "observation": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "remediation": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["open", "resolved", "accepted-risk", "false-positive"]
        },
        "fingerprint": { "type": ["string", "null"] }
      }
    },
    "validationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "environment", "head_sha", "status", "exit_code", "summary"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "head_sha": { "$ref": "#/$defs/gitSha" },
        "status": { "enum": ["PASS", "FAIL", "ERROR"] },
        "exit_code": { "type": ["integer", "null"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "ciCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "observed_at", "status", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["PASS", "FAIL", "PENDING", "CANCELLED", "UNKNOWN"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": ["string", "null"] }
      }
    }
  }
}
